# ─────────────────────────────────────────
# Stayflix API — Environment Variables
# Copy this file to .env and fill in values
# ─────────────────────────────────────────

# ── App ──────────────────────────────────
NODE_ENV=production          # development | staging | production | local | test
PORT=8080

# ── Database (MySQL) ─────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=stayflix
DATABASE_PASSWORD=
DATABASE_NAME=stayflix

# ── JWT Secrets ───────────────────────────
# Generate strong random strings: openssl rand -base64 64
JWT_SECRET_KEY=
ADMIN_JWT_SECRET_KEY=
RESET_PWD_JWT_SECRET_KEY=
ADMIN_RESET_PWD_JWT_SECRET_KEY=

# ── SMTP (Email) ──────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Stayflix <no-reply@stayflix.com>

# ── Termii (SMS / OTP) ────────────────────
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_SMS_CHANNEL=generic

# ── Paystack (Payments) ───────────────────
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=
